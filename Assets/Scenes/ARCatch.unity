  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1c28c7bec1f918243a80b1dcc0116c0b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ChaseTutorialController
  m_chaseController: {fileID: 261449511}
  m_chaseDirector: {fileID: 261449513}
  m_crateOpeningController: {fileID: 261449509}
  m_hologramController: {fileID: 1453320202}
  m_dialogueController: {fileID: 488561831}
  m_introductionMessage: "Salut ! Moi, c'est Poulpy. Pour continuer notre route,
    il va falloir bricoler quelque chose. J'ai besoin de 6 objets. \xC0 toi de les
    retrouver !"
  m_firstZoneMessage: "Les objets sont cach\xE9s dans des caisses. Cherche les zones
    \xE9tranges autour de toi : c'est l\xE0 qu'on peut en r\xE9cup\xE9rer !"
  m_extractionMessage: "Une caisse est coinc\xE9e ici. Il va falloir la r\xE9cup\xE9rer
    !"
  m_openingMachineMessage: "Bien jou\xE9 ! Mais cette caisse est verrouill\xE9e...
    Heureusement, je t'ai envoy\xE9 une machine pour l'ouvrir. Cherche-la autour
    de toi !"
  m_crateOpeningMessage: "Place ta caisse dans la machine pour d\xE9couvrir ce qu'elle
    contient."
  m_crateUpgradeMessage: "Toutes les caisses ne se valent pas ! En les am\xE9liorant,
    tu pourras augmenter tes chances d'obtenir quelque chose d'int\xE9ressant."
  m_firstHologramMessage: "Parfait, on a notre premier objet ! Retourne la tablette
    face vers le sol pour voir tout ce qu'on a r\xE9cup\xE9r\xE9 dans l'hologramme."
  m_tutorialEndingMessage: "Tu sais maintenant tout ce qu'il faut ! \xC0 toi de trouver
    les 6 objets. Je te laisse te d\xE9brouiller... Reviens me voir quand tu les
    auras tous !"
  m_debugMode: 0
